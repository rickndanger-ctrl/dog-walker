{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dog Walker official job form v1",
  "type": "object", "additionalProperties": false,
  "required": ["dog_walker", "name", "goal", "constraints", "steps"],
  "properties": {
    "dog_walker": {"type": "integer", "const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "constraints": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "mode": {"enum": ["auto", "supervised"]},
    "max_turns": {"type": "integer", "minimum": 1, "maximum": 1000},
    "steps": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "prompt", "success_criteria", "checks"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 80, "not": {"enum": ["complete", "pause"]}},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 20000},
        "success_criteria": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "retry_prompt": {"type": "string", "minLength": 1, "maxLength": 5000},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 10},
        "timeout": {"type": "integer", "minimum": 10, "maximum": 21600},
        "approval": {"type": "boolean"},
        "on_pass": {"type": "string"}, "on_exhausted": {"type": "string"},
        "checks": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/check"}},
        "questions": {"type": "object", "maxProperties": 8, "additionalProperties": {"$ref": "#/$defs/question"}}
      }
    },
    "check": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["type", "argv"], "properties": {
        "id": {"type": "string"}, "type": {"const": "command"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "timeout": {"type": "integer", "minimum": 1, "maximum": 1800}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "path"], "properties": {
        "id": {"type": "string"}, "type": {"enum": ["file_exists", "unchanged"]}, "path": {"type": "string", "minLength": 1}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "path", "text"], "properties": {
        "id": {"type": "string"}, "type": {"const": "file_contains"}, "path": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}},
      {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {
        "id": {"type": "string"}, "type": {"enum": ["response_contains", "command_executed"]}, "text": {"type": "string", "minLength": 1}}},
      {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {
        "id": {"type": "string"}, "type": {"const": "no_changes"}}}
    ]},
    "question": {
      "type": "object", "additionalProperties": false, "required": ["type", "instructions"],
      "properties": {
        "type": {"enum": ["noul", "choice", "score"]}, "instructions": {"type": "string", "minLength": 1, "maxLength": 1500},
        "threshold": {"type": "number", "minimum": 0.5, "maximum": 1},
        "expected": {"type": ["boolean", "string"]}, "minimum": {"type": "integer", "minimum": 0},
        "criteria": {"type": ["array", "object"], "minItems": 2, "maxItems": 10, "items": {"type": "string"}, "minProperties": 2, "maxProperties": 10, "additionalProperties": {"type": "string"}}
      }
    }
  }
}
